---
import Lightbox from './Lightbox.astro';

interface Props {
	title: string;
	imagePath: string;
	kicker?: string;
}

const { title, imagePath, kicker = "Redesigning" } = Astro.props;
---

<section class="case-hero">
	<div class="case-hero-content">
		<h1 class="display">{kicker}</h1>
		<p class="case-hero-title display">{title}</p>
		<Lightbox src={imagePath} alt={`${title} hero image`}>
			<img class="case-hero-image" src={imagePath} alt={`${title} hero image`} loading="lazy" />
		</Lightbox>
	</div>
</section>

<style>
	.case-hero {
		padding: var(--layout-section-y) var(--layout-page-padding) var(--space-11);
	}

	.case-hero-content {
		display: grid;
		gap: var(--space-8);
	}

	h1,
	.case-hero-title {
		font-size: var(--text-xxl);
	}

	.case-hero-title {
		border-top: 1px solid var(--color-line-primary);
		font-weight: 500;
		text-align: right;
	}

	.case-hero-image {
		border-radius: 8px;
		display: block;
		height: auto;
		width: 100%;
	}

	@media (max-width: 760px) {
		.case-hero-title {
			font-weight: 400;
			padding-top: var(--space-6);
		}

		.case-hero-image {
			aspect-ratio: auto;
			height: auto;
		}
	}
</style>
