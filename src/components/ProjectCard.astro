---
import Tag from "./Tag.astro";

interface Props {
	title: string;
	description: string;
	href?: string;
	target?: string;
	rel?: string;
	tags?: string[];
	imagePath?: string;
	imagePosition?: string;
}

const {
	title,
	description,
	href = "#",
	target,
	rel,
	tags = [],
	imagePath,
	imagePosition = "center",
} = Astro.props;
const imageStyle = imagePath
	? `--project-card-image: url("${imagePath}"); --project-card-image-position: ${imagePosition};`
	: undefined;
---

<article
	class:list={["project-card", "project-card--interactive", "section--ruled", imagePath && "project-card--with-image"]}
	style={imageStyle}
>
	{imagePath && (
		<>
			<span class="project-card__image" aria-hidden="true"></span>
			<span class="project-card__overlay" aria-hidden="true"></span>
		</>
	)}
	<a class="project-title" href={href} target={target} rel={rel}>
		<span>{title}</span>
		<span aria-hidden="true">→</span>
	</a>
	<p>{description}</p>
	{tags.length > 0 && (
		<ul class="tags" aria-label={`${title} tags`}>
			{tags.map((tag) => (
				<li><Tag label={tag} /></li>
			))}
		</ul>
	)}
</article>

<style>
	.project-card {
		background: var(--color-surface-primary);
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		justify-content: center;
		overflow: hidden;
		padding: var(--layout-section-y) var(--layout-page-padding);
		position: relative;
		transition: background-color 180ms ease-in-out;
	}

	.project-card > a,
	.project-card > p,
	.project-card > .tags {
		position: relative;
		z-index: 2;
	}

	.project-card > .project-card__image,
	.project-card > .project-card__overlay {
		inset: 0;
		pointer-events: none;
		position: absolute;
	}

	.project-card__image {
		background-image: var(--project-card-image);
		background-position: var(--project-card-image-position, center);
		background-size: cover;
		transform: translateY(12px) scale(1.02);
		transition: opacity 420ms ease-out, transform 420ms ease-out;
		z-index: 0;
	}

	.project-card__overlay {
		background: linear-gradient(82deg, #150E32 39.9%, #3D4160 92.49%);
		opacity: 0;
		transition: opacity 420ms ease-out;
		z-index: 1;
	}

	.project-card--with-image .project-card__image {
		opacity: 0;
	}

	.project-title {
		align-items: center;
		color: var(--color-text-headline);
		display: flex;
		font-family: var(--font-display);
		font-size: var(--text-l);
		gap: var(--space-6);
		line-height: var(--leading-tight);
		position: static;
		text-decoration: none;
		transition: color 180ms ease-in-out, gap 180ms ease-in-out, transform 360ms ease-in-out;
		width: 100%;
	}

	.project-title:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: var(--space-2);
	}

	.project-title span:first-child {
		max-width: min(100%, 72rem);
	}

	.project-title::after {
		content: "";
		inset: 0;
		position: absolute;
		z-index: 2;
	}

	p {
		color: var(--color-text-primary);
		font-size: var(--text-m);
		line-height: var(--leading-body);
		max-width: var(--layout-measure);
		transition: color 180ms ease-in-out, transform 360ms ease-in-out;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tags :global(.tag) {
		transition: border-color 180ms ease-in-out, color 180ms ease-in-out, transform 360ms ease-in-out;
	}

	.project-card--interactive:focus-within {
		background: var(--color-button-bg-primary);
	}

	.project-card--interactive:focus-within .project-title {
		color: var(--color-surface-primary);
		gap: var(--space-10);
	}

	.project-card--interactive:focus-within .project-title span,
	.project-card--interactive:focus-within p,
	.project-card--interactive:focus-within .tags {
		transform: translateX(24px);
	}

	.project-card--interactive:focus-within p {
		color: var(--color-surface-primary);
	}

	.project-card--interactive:focus-within .tags :global(.tag) {
		border-color: var(--color-line-primary);
		color: var(--color-line-secondary);
	}

	.project-card--with-image:focus-within .project-card__image,
	.project-card--with-image:focus-within .project-card__overlay {
		opacity: 1;
	}

	.project-card--with-image:focus-within .project-card__overlay {
		opacity: 0.6;
	}

	.project-card--with-image:focus-within .project-card__image {
		transform: translateY(0) scale(1.02);
	}

	@media (hover: hover) and (pointer: fine) {
		.project-card--interactive:hover {
			background: var(--color-button-bg-primary);
		}

		.project-card--interactive:hover .project-title {
			color: var(--color-surface-primary);
			gap: var(--space-10);
		}

		.project-card--interactive:hover .project-title span,
		.project-card--interactive:hover p,
		.project-card--interactive:hover .tags {
			transform: translateX(24px);
		}

		.project-card--interactive:hover p {
			color: var(--color-surface-primary);
		}

		.project-card--interactive:hover .tags :global(.tag) {
			border-color: var(--color-line-primary);
			color: var(--color-line-secondary);
		}

		.project-card--with-image:hover .project-card__image,
		.project-card--with-image:hover .project-card__overlay {
			opacity: 1;
		}

		.project-card--with-image:hover .project-card__overlay {
			opacity: 0.6;
		}

		.project-card--with-image:hover .project-card__image {
			transform: translateY(0) scale(1.02);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card,
		.project-card__image,
		.project-card__overlay,
		.project-title,
		.project-title span,
		p,
		.tags,
		.tags :global(.tag) {
			transition: none;
		}

		.project-card__image {
			transform: translateY(0) scale(1);
		}
	}

	@media (max-width: 720px) {
		.project-card {
			gap: var(--space-8);
		}

		.project-title {
			align-items: flex-end;
			font-size: var(--text-mobile-card-title);
			gap: var(--space-3);
			justify-content: space-between;
		}

		p {
			font-size: var(--text-s);
			line-height: var(--leading-ui);
		}

		.tags li:nth-child(n + 5) {
			display: none;
		}
	}
</style>
