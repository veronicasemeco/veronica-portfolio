---
interface Metric {
	value: string;
	label: string;
	emphasis?: string;
}

interface Props {
	metrics: Metric[];
}

const { metrics } = Astro.props;
---

<ul class="impact-metrics" aria-label="Impact metrics">
	{metrics.map((metric) => (
		<li>
			<span class="value">{metric.value}</span>
			<span class="rule" aria-hidden="true"></span>
			<p>
				{metric.emphasis && metric.label.includes(metric.emphasis) ? (
					<>
						{metric.label.split(metric.emphasis)[0]}
						<strong>{metric.emphasis}</strong>
						{metric.label.split(metric.emphasis).slice(1).join(metric.emphasis)}
					</>
				) : (
					metric.label
				)}
			</p>
		</li>
	))}
</ul>

<style>
	.impact-metrics {
		--surface-secondary-img: #ededf7;
		background: var(--surface-secondary-img);
		border-radius: 8px;
		color: var(--color-text-primary);
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-auto-rows: 1fr;
		list-style: none;
		margin: 0;
		overflow: hidden;
		padding: 44px var(--space-8);
	}

	li {
		display: grid;
		grid-template-rows: auto auto 1fr;
		gap: var(--space-6);
		min-width: 0;
		padding: 0 var(--space-8);
	}

	li + li {
		border-left: 1px solid var(--color-line-secondary);
	}

	.value {
		color: var(--color-text-headline);
		font-family: var(--font-display);
		font-size: var(--text-mobile-card-title);
		line-height: var(--leading-tight);
	}

	.rule {
		background: var(--color-text-headline);
		height: 4px;
		width: 64px;
	}

	p {
		align-self: end;
		font-size: var(--text-s);
		line-height: var(--leading-ui);
		margin: 0;
		text-wrap: balance;
	}

	li:first-child {
		padding-left: 0;
	}

	li:last-child {
		padding-right: 0;
	}

	@media (max-width: 1024px) {
		.impact-metrics {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		li {
			padding: var(--space-6) var(--space-8);
		}

		li + li {
			border-left: 0;
		}

		li:nth-child(even) {
			border-left: 1px solid var(--color-line-secondary);
		}

		li:nth-child(n + 3) {
			border-top: 1px solid var(--color-line-secondary);
		}

		li:nth-child(odd) {
			padding-left: 0;
		}

		li:nth-child(even) {
			padding-right: 0;
		}
	}

	@media (max-width: 760px) {
		.impact-metrics {
			grid-template-columns: 1fr;
		}

		li,
		li:nth-child(odd),
		li:nth-child(even) {
			border-left: 0;
			padding: var(--space-6) 0;
		}

		li:first-child {
			padding-top: 0;
		}

		li + li,
		li:nth-child(n + 3) {
			border-top: 1px solid var(--color-line-secondary);
		}

		li:last-child {
			padding-bottom: 0;
		}
	}
</style>
