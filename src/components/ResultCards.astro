---
interface Result {
	label: string;
	detail: string;
}

interface Props {
	results: Result[];
}

const { results } = Astro.props;
---

<div class="result-cards">
	{results.map((result) => (
		<article>
			<strong>{result.label}</strong>
			<p>{result.detail}</p>
		</article>
	))}
</div>

<style>
	.result-cards {
		display: grid;
		gap: var(--space-1);
		width: 100%;
	}

	article {
		border-top: 0.5px solid var(--color-line-secondary);
		display: grid;
		gap: var(--space-4);
		grid-template-columns: 216px minmax(0, 446px);
		padding: var(--space-4) 0;
	}

	strong {
		font-size: var(--text-xs);
		font-weight: 500;
		line-height: var(--leading-tight);
	}

	p {
		font-size: var(--text-xs);
		line-height: 1.45;
	}

	@media (max-width: 760px) {
		article {
			gap: var(--space-1);
			grid-template-columns: 1fr;
			padding: var(--space-2) 0;
		}
	}
</style>
