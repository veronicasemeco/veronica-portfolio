---
import Lightbox from './Lightbox.astro';

interface Props {
	number: number;
	title: string;
	paragraphs: string[];
	imagePath: string;
	imageAlt: string;
}

const { number, title, paragraphs, imagePath, imageAlt } = Astro.props;
const mediaItems = [{ src: imagePath, alt: imageAlt }];
---

<article class="key-decision">
	<p class="eyebrow">Key decision {number}</p>
	<h3 class="display">{title}</h3>
	<div class="decision-body">
		<div>
			{paragraphs.map((paragraph) => <p set:html={paragraph} />)}
		</div>
		<slot name="callout" />
	</div>
	<div class="decision-media" aria-label={`${title} media`}>
		{mediaItems.map((item) => (
			item.src ? (
				<Lightbox src={item.src} alt={item.alt}>
					<img class="decision-image image-reveal" src={item.src} alt={item.alt} loading="lazy" />
				</Lightbox>
			) : (
				<div class="decision-image placeholder" role="img" aria-label={`${item.alt}. Intended image path: ${item.src}`}>
					<span>Image placeholder</span>
				</div>
			)
		))}
	</div>
</article>

<style>
	.key-decision {
		display: grid;
		gap: var(--space-8);
		padding: var(--space-11) 0;
	}

	h3 {
		font-size: var(--text-l);
	}

	.eyebrow {
		font-weight: 500;
		letter-spacing: 1.2px;
		text-transform: uppercase;
	}

	.decision-body {
		display: grid;
		gap: var(--space-8);
		grid-template-columns: minmax(0, var(--layout-measure)) var(--layout-aside);
		justify-content: space-between;
	}

	.decision-body p {
	font-size: var(--text-s);
	line-height: var(--leading-ui);
}

	.decision-body p + p {
		margin-top: var(--space-3);
	}

	

	.decision-media {
		display: grid;
	}

	.decision-image {
		border-radius: 8px;
		display: block;
		height: auto;
		width: 100%;
	}

	.decision-image.placeholder {
		align-items: center;
		aspect-ratio: 1376 / 572;
		background: linear-gradient(135deg, var(--color-line-primary), var(--color-surface-primary));
		color: var(--color-text-secondary);
		display: flex;
		font-size: var(--text-xs);
		justify-content: center;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media (max-width: 760px) {
		.key-decision {
			gap: var(--space-8);
		}

		.decision-body {
			gap: var(--space-6);
			grid-template-columns: 1fr;
		}

		h3 {
			font-size: var(--text-mm);
			font-weight: 500;
		}

		.decision-image.placeholder {
			aspect-ratio: 358 / 295;
		}
	}
</style>
