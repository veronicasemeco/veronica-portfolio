---
const year = 2026;
---

<footer class="site-footer dark-section">
	<h2 class="display">Get in Touch</h2>
	<div class="footer-row">
		<p class="copyright">© {year} Veronica Semeco. All rights reserved.</p>
		<nav class="footer-links" aria-label="Footer navigation">
			<a href="mailto:veronicasemeco@gmail.com">veronicasemeco@gmail.com</a>
			<a href="https://www.linkedin.com/in/veronicasemeco/" target="_blank" rel="noreferrer">LinkedIn</a>
		</nav>
	</div>
</footer>

<script>
	const footer = document.querySelector<HTMLElement>(".site-footer");
	const page = document.querySelector<HTMLElement>(".page");
	const root = document.documentElement;
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	if (footer && page && !reducedMotion.matches) {
		const maxStretch = 40;
		let stretch = 0;
		let touchY: number | undefined;
		let settleTimer: ReturnType<typeof setTimeout>;

		const isAtBottom = () =>
			window.scrollY + window.innerHeight >=
			document.documentElement.scrollHeight - 1;

		const setStretch = (nextStretch: number) => {
			stretch = Math.min(maxStretch, Math.max(0, nextStretch));
			root.style.setProperty("--footer-elastic-offset", `${stretch}px`);
			footer.classList.add("footer-elastic-active");
			page.classList.add("footer-elastic-active");
		};

		const settle = () => {
			clearTimeout(settleTimer);
			requestAnimationFrame(() => {
				footer.classList.remove("footer-elastic-active");
				page.classList.remove("footer-elastic-active");
				root.style.setProperty("--footer-elastic-offset", "0px");
			});
		};

		window.addEventListener("wheel", (event) => {
			if (isAtBottom() && event.deltaY > 0) {
				setStretch(stretch + Math.min(event.deltaY * 0.4, 20));
				clearTimeout(settleTimer);
				settleTimer = setTimeout(settle, 120);
			}
		}, { passive: true });

		window.addEventListener("touchstart", (event) => {
			touchY = event.touches[0]?.clientY;
		}, { passive: true });

		window.addEventListener("touchmove", (event) => {
			const nextTouchY = event.touches[0]?.clientY;

			if (touchY !== undefined && nextTouchY !== undefined && isAtBottom() && nextTouchY < touchY) {
				setStretch(stretch + Math.min((touchY - nextTouchY) * 0.35, 12));
			}

			touchY = nextTouchY;
		}, { passive: true });

		window.addEventListener("touchend", () => {
			touchY = undefined;
			if (stretch > 0) settle();
		}, { passive: true });

		window.addEventListener("touchcancel", () => {
			touchY = undefined;
			if (stretch > 0) settle();
		}, { passive: true });
	}
</script>

<style>
	.site-footer {
		background: transparent;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		height: var(--footer-reveal-height);
		isolation: isolate;
		padding: var(--space-10) var(--layout-page-padding);
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 0;
	}

	.site-footer::before {
		background: var(--color-text-headline);
		content: "";
		inset: calc(0px - var(--footer-elastic-offset, 0px)) 0 0;
		pointer-events: none;
		position: absolute;
		z-index: 0;
	}

	.site-footer > * {
		position: relative;
		z-index: 1;
	}

	.site-footer.footer-elastic-active::before {
		transition: none;
	}

	.site-footer::before {
		transition: inset 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.site-footer h2 {
		color: var(--color-line-secondary);
		font-size: var(--text-xxl);
		font-weight: 500;
		max-width: none;
		white-space: nowrap;
	}

	.footer-row {
		align-items: flex-end;
		display: flex;
		justify-content: space-between;
		width: 100%;
	}

	.copyright,
	.footer-links {
		font-size: var(--text-xs);
		line-height: var(--leading-tight);
	}

	.site-footer .copyright {
		color: var(--color-line-secondary);
	}

	.footer-links {
		color: var(--color-line-secondary);
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 10.5rem;
	}

	.footer-links a {
		align-self: flex-start;
	}

	@media (max-width: 720px) {
		.site-footer {
			padding-bottom: var(--space-12);
		}

		.site-footer h2 {
			font-size: var(--text-l);
		}

		.footer-row {
			align-items: flex-start;
			flex-direction: column;
			gap: 28px;
		}

		.footer-links {
			gap: var(--space-4);
		}
	}
</style>
