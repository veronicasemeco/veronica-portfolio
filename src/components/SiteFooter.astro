---
const year = 2026;
---

<footer class="site-footer dark-section">
	<h2 class="display">Get in Touch</h2>
	<div class="footer-row">
		<p class="copyright">© {year} Veronica Semeco. All rights reserved.</p>
		<nav class="footer-links" aria-label="Footer navigation">
			<a href="mailto:veronicasemeco@gmail.com">veronicasemeco@gmail.com</a>
			<a href="https://www.linkedin.com/in/veronicasemeco/" target="_blank" rel="noreferrer">LinkedIn</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-10) var(--layout-page-padding);
	}

	.site-footer h2 {
		color: var(--color-text-tertiary);
		font-size: var(--text-xxl);
		font-weight: 500;
		max-width: none;
		white-space: nowrap;
	}

	.footer-row {
		align-items: flex-end;
		display: flex;
		justify-content: space-between;
		width: 100%;
	}

	.copyright,
	.footer-links {
		font-size: var(--text-xs);
		line-height: var(--leading-tight);
	}

	.site-footer .copyright {
		color: var(--color-text-tertiary);
	}

	.footer-links {
		color: var(--color-button-label-primary);
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 10.5rem;
	}

	@media (max-width: 720px) {
		.site-footer {
			padding-bottom: var(--space-12);
		}

		.site-footer h2 {
			font-size: var(--text-l);
		}

		.footer-row {
			align-items: flex-start;
			flex-direction: column;
			gap: 28px;
		}

		.footer-links {
			gap: var(--space-4);
		}
	}
</style>
