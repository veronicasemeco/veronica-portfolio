---
interface TimelineEntry {
	company: string;
	role: string;
	location: string;
	period: string;
	description: string;
}

interface Props {
	entries: TimelineEntry[];
}

const { entries } = Astro.props;
---

<ol class="timeline">
	{entries.map((entry) => (
		<li class="timeline-item">
			<div class="timeline-marker" aria-hidden="true"></div>
			<div class="timeline-content">
				<p class="eyebrow timeline-company">{entry.company}</p>
				<h3 class="display">{entry.role}</h3>
				<h4 class="timeline-detail">{entry.location}, {entry.period}</h4>
				<p>{entry.description}</p>
			</div>
		</li>
	))}
</ol>

<style>
	.timeline {
		display: grid;
		gap: calc(var(--space-11) * 2);
		list-style: none;
		margin: 0;
		padding: 0;
		position: relative;
	}

	.timeline::before {
		background: var(--color-line-secondary);
		content: "";
		height: 100%;
		left: 5px;
		position: absolute;
		top: 0;
		width: 0.5px;
	}

	.timeline-item {
		display: grid;
		gap: var(--space-8);
		grid-template-columns: 12px minmax(0, 1fr);
		position: relative;
	}

	.timeline-marker {
		background: var(--color-surface-primary);
		border: 0.5px solid var(--color-line-primary);
		border-radius: 50%;
		height: 11px;
		position: relative;
		top: 5px;
		width: 11px;
		z-index: 1;
	}

	.timeline-company {
		font-weight: 500;
	}

	.timeline-content {
		display: grid;
		gap: var(--space-4);
	}

	h3 {
		font-size: var(--text-mm);
	}

	.timeline-detail {
		color: var(--color-text-tertiary);
		font-family: var(--font-display);
		font-size: var(--text-s);
		font-style: italic;
		font-weight: 400;
		line-height: var(--leading-tight);
	}

	.timeline-content p:not(.timeline-company) {
		color: var(--color-text-primary);
		font-size: var(--text-s);
		line-height: var(--leading-ui);
		max-width: var(--layout-measure);
	}

	@media (max-width: 760px) {
		.timeline {
			gap: calc(var(--space-10) * 2);
		}

		.timeline-item {
			gap: var(--space-4);
		}

		h3 {
			font-size: var(--text-s);
		}
	}
</style>
