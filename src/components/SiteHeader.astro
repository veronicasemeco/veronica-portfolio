---
interface Props {
	current?: "home" | "work";
}

const { current = "home" } = Astro.props;
---

<header class="site-header">
	<a class="logo" href="/" aria-label="Verónica Semeco home">Verónica Semeco</a>
	<button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open menu">
		<span aria-hidden="true"></span>
	</button>
	<nav class="nav" id="primary-navigation" aria-label="Primary navigation">
		<a aria-current={current === "work" ? "page" : undefined} href="/#work">Work</a>
		<a href="/about/">About</a>
		<a class="button" href="mailto:veronicasemeco@gmail.com">Get in Touch</a>
	</nav>
</header>

<style>
	.site-header {
		align-items: center;
		background: var(--color-surface-primary);
		display: flex;
		justify-content: space-between;
		padding: var(--space-5) var(--layout-page-padding);
		position: sticky;
		top: 0;
		transform: translateY(0);
		transition: transform 180ms ease-in-out;
		z-index: 20;
	}

	.site-header.is-hidden {
		transform: translateY(-100%);
	}

	.logo {
		color: var(--color-text-headline);
		font-family: var(--font-display);
		font-size: var(--text-mm);
		font-weight: 400;
		line-height: var(--leading-tight);
		white-space: nowrap;
	}

	.logo:focus-visible,
	.nav a:focus-visible,
	.menu-button:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: var(--space-2);
	}

	.nav {
		align-items: center;
		color: var(--color-text-primary);
		display: flex;
		font-size: var(--text-s);
		gap: var(--space-nav-gap);
		line-height: var(--leading-ui);
	}

	.menu-button {
		align-items: center;
		background: transparent;
		border: 0;
		color: var(--color-text-headline);
		cursor: pointer;
		display: none;
		height: 40px;
		justify-content: center;
		padding: 0;
		position: relative;
		width: 40px;
		z-index: 2;
	}

	.menu-button span,
	.menu-button::before,
	.menu-button::after {
		background: currentColor;
		content: "";
		height: 2px;
		position: absolute;
		width: 28px;
	}

	.menu-button span {
		transform: translateY(0);
	}

	.menu-button::before {
		transform: translateY(-8px);
	}

	.menu-button::after {
		transform: translateY(8px);
	}

	.nav a:not(.button):hover,
	.nav a[aria-current="page"] {
		color: var(--color-text-headline);
	}

	.button {
		background: var(--color-button-bg-primary);
		border-radius: var(--radius-button);
		color: var(--color-button-label-primary);
		font-weight: 500;
		line-height: var(--leading-tight);
		padding: var(--space-3);
		transition: background-color 180ms ease-in-out, color 180ms ease-in-out;
	}

	.button:hover,
	.button:focus-visible {
		background: var(--color-text-secondary);
		color: var(--color-button-label-primary);
	}

	@media (max-width: 720px) {
		.site-header {
			min-height: 64px;
			padding: var(--space-3) var(--layout-page-padding);
		}

		.site-header.is-menu-open {
			background: var(--color-text-headline);
			inset: 0;
			min-height: 100dvh;
			position: fixed;
			width: 100%;
			z-index: 100;
		}

		@supports not (min-height: 100dvh) {
			.site-header.is-menu-open {
				min-height: 100vh;
			}
		}

		.site-header.is-menu-open {
			align-items: flex-start;
		}

		.site-header.is-menu-open .logo {
			opacity: 0;
			pointer-events: none;
		}

		.site-header.is-menu-open .menu-button {
			color: var(--color-button-label-primary);
		}

		.site-header.is-menu-open .menu-button span {
			display: none;
		}

		.site-header.is-menu-open .menu-button::before {
			transform: rotate(45deg);
		}

		.site-header.is-menu-open .menu-button::after {
			transform: rotate(-45deg);
		}

		.menu-button {
			display: inline-flex;
		}

		.nav {
			align-items: center;
			background: var(--color-button-bg-primary);
			color: var(--color-button-label-primary);
			display: none;
			flex-direction: column;
			font-size: var(--text-m);
			gap: var(--space-11);
			inset: 0;
			justify-content: flex-start;
			line-height: var(--leading-body);
			min-height: 100dvh;
			padding: calc(80px + var(--layout-section-y)) var(--layout-page-padding) var(--layout-section-y);
			position: absolute;
			z-index: 1;
		}

		@supports not (min-height: 100dvh) {
			.nav {
				min-height: 100vh;
			}
		}

		.site-header.is-menu-open .nav {
			display: flex;
		}

		.nav a:not(.button):hover,
		.nav a[aria-current="page"] {
			color: var(--color-button-label-primary);
		}

		.button {
			background: var(--color-line-secondary);
			color: var(--color-button-bg-primary);
			font-size: var(--text-m);
			padding: var(--space-3);
		}

		.button:hover,
		.button:focus-visible {
			background: var(--color-line-secondary);
			color: var(--color-button-bg-primary);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.button {
			transition: none;
		}
	}
</style>

<script>
	const header = document.querySelector(".site-header");
	const menuButton = header?.querySelector(".menu-button");
	const nav = header?.querySelector(".nav");
	const navLinks = nav?.querySelectorAll("a") || [];
	let isMenuOpen = false;
	let lastScrollY = window.scrollY;
	let lockedBodyOverflow = "";

	const setMenuOpen = (open) => {
		if (!header || !menuButton) return;

		isMenuOpen = open;
		header.classList.toggle("is-menu-open", open);
		header.classList.remove("is-hidden");
		menuButton.setAttribute("aria-expanded", String(open));
		menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");

		if (open) {
			lockedBodyOverflow = document.body.style.overflow;
			document.body.style.overflow = "hidden";
		} else {
			document.body.style.overflow = lockedBodyOverflow;
		}
	};

	menuButton?.addEventListener("click", () => {
		setMenuOpen(!isMenuOpen);
	});

	navLinks.forEach((link) => {
		link.addEventListener("click", () => {
			setMenuOpen(false);
		});
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") {
			setMenuOpen(false);
		}
	});

	window.addEventListener("resize", () => {
		if (window.matchMedia("(min-width: 721px)").matches) {
			setMenuOpen(false);
		}
	});

	window.addEventListener(
		"scroll",
		() => {
			if (!header || isMenuOpen) return;

			const currentScrollY = window.scrollY;
			const scrollDelta = currentScrollY - lastScrollY;

			if (currentScrollY <= 80) {
				header.classList.remove("is-hidden");
				lastScrollY = currentScrollY;
				return;
			}

			if (Math.abs(scrollDelta) < 12) return;

			header.classList.toggle("is-hidden", scrollDelta > 0);
			lastScrollY = currentScrollY;
		},
		{ passive: true }
	);
</script>
