---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<Layout
	title="Veronica Semeco | Senior Product Designer"
	description="Veronica Semeco is a Senior Product Designer working across research, UX strategy, product flows, and polished UI."
>
	<div class="page">
			<SiteHeader />
			<main id="main">
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-intro-stage">
						<div class="hero-line">
							<h1 id="hero-title" class="display">Complex products</h1>
						</div>
						<div class="hero-statement display">
							<span aria-hidden="true">→</span>
							<span>clear experiences.</span>
						</div>
					</div>
					<div class="hero-scroll-content">
						<p>Complex products need more than good screens.</p>
						<p>
							The most challenging product work isn't usually visual. It's making sense of competing constraints, unclear requirements, stakeholder priorities, technical realities, and user needs.
						</p>
					</div>
				</section>

				<div id="work">
					<SectionHeader title="Selected Work" />
					<ProjectCard
						title="Redesigning NAVIT’s Mobility Platform"
						description="Helping a fast-moving startup turn fragmented mobility benefit flows into a clearer platform for employees and HR teams."
						href="/work/navit-platform/"
						imagePath="/images/homepage/navit-hero.png"
						tags={["Design Foundations", "UX Strategy", "Mobile App + Dashboard", "Design Foundations"]}
					/>
					<ProjectCard
						title="Building NAVIT’s first continuous research loop"
						description="Creating a lightweight research system to bring end-user feedback into product decisions."
						href="/work/navit-research-loop/"
						imagePath="/images/homepage/navit-research-hero.png"
						tags={["UX Research", "Research Ops", "AI-assisted synthesis", "SaaS"]}
					/>
					<ProjectCard
						title="From catalog browsing to fit-guided shopping"
						description="Moving from a generic swimwear catalog to a fit-guided shopping experience."
						href="/work/haisabikini/"
						imagePath="/images/homepage/haisa-hero.png"
						tags={["E-commerce Strategy", "UX", "IA", "Product Data", "Shopify"]}
					/>
					<ProjectCard
						title="Earlier work"
						description="Earlier brand, web, and product work from agency, freelance, and startup projects."
						href="https://veronica-semeco.squarespace.com/earlier-work"
						target="_blank"
						rel="noopener noreferrer"
					/>
				</div>

				<section id="about" class="what-i-bring" aria-labelledby="what-i-bring-title">
					<div class="what-i-bring-inner">
						<h2 id="what-i-bring-title" class="display">
							<a class="what-i-bring-link" href="/about/">
								<span>What I bring</span>
								<span aria-hidden="true">→</span>
							</a>
						</h2>
						<div class="what-i-bring-content">
							<p>
								13+ years across UX, product, and brand, with recent work in B2B SaaS, mobility benefits, e-commerce, and AI-supported research and design workflows.
							</p>
							<ul>
								<li>Product design for complex flows</li>
								<li>Lightweight research that informs decisions</li>
								<li>UX strategy and product structure</li>
								<li>Polished UI for apps, dashboards, and websites</li>
								<li>Creative direction for digital products</li>
							</ul>
						</div>
					</div>
				</section>

				<!-- I use AI as a design and development partner. Product judgment is all mine :) -->
			</main>
	</div>
	<SiteFooter />
</Layout>

<style>
	.hero {
		isolation: isolate;
	}

	.hero-intro-stage {
		background: var(--color-surface-primary);
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		height: 100vh;
		height: 100svh;
		min-height: 638px;
		padding: var(--layout-section-y) var(--layout-page-padding);
		position: sticky;
		top: 0;
		z-index: 0;
	}

	.hero-scroll-content {
		background: color-mix(in srgb, var(--color-surface-primary) 88%, transparent);
		backdrop-filter: blur(8px);
		color: var(--color-text-primary);
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		min-height: max(100vh, 638px);
		min-height: max(100svh, 638px);
		padding: var(--layout-section-y) var(--layout-page-padding);
		position: relative;
		z-index: 1;
		-webkit-backdrop-filter: blur(8px);
	}

	.hero-line h1 {
		animation: hero-title-in 1886ms cubic-bezier(0, 0, 0.58, 1) both;
		font-size: var(--text-xxl);
		will-change: filter, opacity;
	}

	.hero-statement {
		align-items: center;
		animation: hero-statement-in 1200ms cubic-bezier(0.5, 1.7, 0.3, 1) 700ms both;
		border-top: 1px solid var(--color-line-primary);
		display: flex;
		font-size: var(--text-xxl);
		font-weight: 500;
		gap: var(--space-4);
		justify-content: flex-end;
		min-height: 363px;
		text-align: right;
	}

	.hero-statement span:last-child {
		max-width: 58.5rem;
	}

	@keyframes hero-title-in {
		from {
			filter: blur(65px);
			opacity: 0;
		}

		to {
			filter: blur(0);
			opacity: 1;
		}
	}

	@keyframes hero-statement-in {
		from {
			opacity: 0;
			transform: translateX(clamp(-700px, -70vw, -180px));
		}

		to {
			transform: translateX(0);
			opacity: 1;
		}
	}

	.hero-scroll-content > p {
		font-family: var(--font-display);
		font-size: var(--text-mm);
		font-weight: 400;
		line-height: var(--leading-tight);
		margin: 0;
		max-width: 70.75rem;
	}

	.what-i-bring {
		background: var(--color-surface-primary);
		color: var(--color-text-primary);
		padding: var(--layout-section-y) var(--layout-page-padding);
	}

	.what-i-bring-inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.what-i-bring-inner > * {
		transition: transform 360ms ease-in-out;
	}

	.what-i-bring h2 {
		font-size: var(--text-xl);
	}

	.what-i-bring-link {
		align-items: center;
		display: flex;
		gap: var(--space-6);
	}

	.what-i-bring-link:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: var(--space-2);
	}

	@media (hover: hover) and (pointer: fine) {
		.what-i-bring:hover .what-i-bring-inner > *,
		.what-i-bring:has(.what-i-bring-link:focus-visible) .what-i-bring-inner > * {
			transform: translateX(24px);
		}
	}

	.what-i-bring-content {
		border-top: 0.5px solid var(--color-line-secondary);
		display: grid;
		gap: var(--space-8);
		grid-template-columns: minmax(0, 42rem) minmax(18rem, 28rem);
		justify-content: space-between;
		padding-top: var(--space-8);
	}

	.what-i-bring p,
	.what-i-bring li {
		color: var(--color-text-primary);
		font-size: var(--text-s);
		line-height: var(--leading-ui);
	}

	.what-i-bring ul {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-intro-stage {
			position: relative;
			top: auto;
		}

		.hero-line h1,
		.hero-statement {
			animation: none;
			filter: none;
			opacity: 1;
			transform: none;
			will-change: auto;
		}

		.what-i-bring-inner > * {
			transition: none;
		}
	}

	@media (max-width: 760px) {
		.hero-intro-stage {
			min-height: 638px;
		}

		.hero-statement {
			align-items: flex-end;
			flex-direction: row;
			font-size: var(--text-l);
			min-height: 193px;
			padding-top: var(--space-6);
			text-align: right;
		}

		.what-i-bring-content {
			gap: 48px;
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.hero-statement {
			animation-delay: 1550ms;
		}
	}
</style>
